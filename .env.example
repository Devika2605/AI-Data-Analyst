# ---------------------------------------------------------------------------
# AI Data Analyst — environment configuration
# Copy this file to .env and fill in values as needed.
# The app runs fully WITHOUT an LLM key (deterministic/rule-based mode);
# adding one enables LLM-polished explanations and richer language understanding.
# ---------------------------------------------------------------------------

# LLM provider: "anthropic" | "openai" | "groq" | "none"
LLM_PROVIDER=none

# API key for the selected provider. Never commit real keys.
LLM_API_KEY=

# Model name. Examples:
#   Anthropic: claude-sonnet-4-6
#   OpenAI:    gpt-4o-mini
#   Groq:      llama-3.3-70b-versatile  (or another model from console.groq.com)
LLM_MODEL=claude-sonnet-4-6

# Optional: override the API base URL. Only needed for OpenAI-compatible
# providers other than OpenAI itself — Groq's default is filled in
# automatically when LLM_PROVIDER=groq, so you can normally leave this blank.
LLM_BASE_URL=

# Upload limits
MAX_UPLOAD_SIZE_MB=50

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost

# Storage paths (used when running locally without Docker; Docker overrides these)
DATABASE_PATH=./storage/app.db
CHROMA_PATH=./storage/chroma

# Feature flags
CACHE_ENABLED=true
SEMANTIC_SEARCH_ENABLED=true

# --- Frontend-only (used by `npm run dev`) ----------------------------------
# Backend URL the Vite dev-server proxy should forward /api requests to
VITE_BACKEND_URL=http://localhost:8000
